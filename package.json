{
  "name": "landing-builder-factory",
  "version": "1.0.0",
  "description": "Lead Intelligence + Preview Generation Factory",
  "scripts": {
    "test:normalizer": "node core/lead-normalizer.test.js",
    "test:design-md": "node src/tests/design-md.test.js",
    "campaign": "node src/cli/run-campaign.js",
    "preview": "node src/cli/generate-preview.js",
    "dashboard": "node src/cli/dashboard.js",
    "smoke": "node src/tests/smoke-campaign.js",
    "discover:dentists:v2": "node src/lead_discovery/google_places_dentists_v2.js",
    "discover:dentists:v3": "node src/lead_discovery/google_places_dentists_v3.js",
    "design:lint": "node scripts/lint-design-md.mjs",
    "design:diff": "node scripts/diff-niche-design-md.js",
    "design:build-niches": "node scripts/build-niche-design-md.js",
    "design:check-niches": "node scripts/build-niche-design-md.js --check",
    "design:build-prompt": "node scripts/build-design-director-prompt.js",
    "design:check-prompt": "node scripts/build-design-director-prompt.js --check",
    "design:spec": "designmd spec",
    "design:export-tailwind": "designmd export --format css-tailwind",
    "compare": "node scripts/compare-screenshots.js",
    "variants": "node src/cli/generate-variants.js",
    "qa": "node scripts/vision-qa.js",
    "packet": "node src/cli/build-packet.js",
    "preview:batch": "node src/cli/run-batch.js",
    "approvals": "node src/cli/build-approval-queue.js",
    "serve": "python3 -m http.server 8765",
    "od:install": "cd open-design && pnpm install",
    "od:dev": "cd open-design && pnpm tools-dev run web",
    "od:daemon": "cd open-design && pnpm tools-dev start web --daemon-port 17456 --web-port 17573",
    "od:status": "cd open-design && pnpm tools-dev status --json",
    "od:stop": "cd open-design && pnpm tools-dev stop",
    "od:typecheck": "cd open-design && pnpm typecheck"
  },
  "dependencies": {
    "@google/design.md": "^0.1.1",
    "csv-parse": "^5.5.6",
    "express": "^5.2.1",
    "playwright": "^1.58.2"
  }
}
