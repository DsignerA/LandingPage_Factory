# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# ── Google Maps Platform ───────────────────────────────────────────────────────
# Required for lead discovery (google_places_dentists_v2.js).
# Enable the Places API at: https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Optional. When set, the preview pipeline will generate hero + card images
# with gpt-image-2 whenever scraping yields no usable photo for a client.
# Cost: ~$0.04-0.08 per image at high quality. Cache-keyed by prompt hash so
# reruns reuse the same files.
OPENAI_API_KEY=your_openai_api_key_here

# Override the default image model (rev-locked snapshot, e.g.):
# LANDING_BUILDER_IMAGE_MODEL=gpt-image-2-2026-04-21

# OpenAI models for text (used elsewhere in the project):
OPENAI_MODEL_EDITOR=gpt-4.1
OPENAI_MODEL_PLANNER=gpt-4.1

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# When set, enables: (a) hero copy rewritten in brand voice (llm-rewrite),
# (b) vision-based design QA (`npm run qa <slug>`).
# ANTHROPIC_API_KEY=sk-ant-...

# Override the default model used by llm-rewrite + vision-qa:
# LANDING_BUILDER_LLM_MODEL=claude-sonnet-4-6

# ── Pipeline toggles ──────────────────────────────────────────────────────────
# Set to 1 to skip downloading scraped images locally (faster, but previews
# break if the source CDN changes):
# LANDING_BUILDER_SKIP_LOCALIZE=1
# Set to 1 to skip OpenAI image generation even when OPENAI_API_KEY is set:
# LANDING_BUILDER_SKIP_IMAGE_GEN=1
# Set to 1 to show the internal "Designed to convert..." upgrade-signal banner
# on the customer-facing preview (off by default — it's internal sales copy):
# LANDING_BUILDER_SHOW_UPGRADE_SIGNAL=1

# ── Screenshot provider ───────────────────────────────────────────────────────
# "local" (Playwright, default) or "browserless"
# Use "local" for file:// previews; use "browserless" for public http/https URLs.
SCREENSHOT_PROVIDER=local

# Browserless.io credentials (only required when SCREENSHOT_PROVIDER=browserless)
BROWSERLESS_TOKEN=your_browserless_token_here
BROWSERLESS_URL=https://chrome.browserless.io
